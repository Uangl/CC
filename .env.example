# 复制本文件为 .env 并填入你的 key，然后重启：npx expo start -c
#
# 不填也能运行：未配置时自动使用本地模拟（Mock），功能可正常体验。

# ── 智谱 AI（GLM-4-Flash，免费）──────────────────────────
# 用于：费曼讲题评分/追问、分层提示、AI变式题生成
# 申请：https://open.bigmodel.cn/  → 控制台 → API Keys
# key 形如 xxxxxxxxxxxx.yyyyyyyy
EXPO_PUBLIC_ZHIPU_API_KEY=

# ── 百度 OCR（通用文字识别，免费1000次/月）───────────────
# 用于：拍照/选图后自动识别题干文字
# 申请：https://console.bce.baidu.com/  → 文字识别 → 创建应用
EXPO_PUBLIC_BAIDU_OCR_API_KEY=
EXPO_PUBLIC_BAIDU_OCR_SECRET_KEY=
