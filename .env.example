# ============================================================
# 混凝土配合比智能推荐工具 · 联网版 环境变量
# 复制为 .env 后填写： cp .env.example .env
# ============================================================

# 服务端口
PORT=3000

# ===== AI 大模型（OpenAI 兼容接口）=====
# AI_API_BASE 填到 /chat/completions 之前的部分，常见取值：
#   DeepSeek :  https://api.deepseek.com/v1
#   通义千问  :  https://dashscope.aliyuncs.com/compatible-mode/v1
#   Kimi     :  https://api.moonshot.cn/v1
#   智谱 GLM  :  https://open.bigmodel.cn/api/paas/v4
#   OpenAI   :  https://api.openai.com/v1
AI_API_BASE=https://api.deepseek.com/v1

# 你的 API Key（仅保存在服务端，不下发到浏览器）。留空则前端 AI 功能显示"未配置"。
AI_API_KEY=

# 模型名，需与上面接口匹配，例如：
#   deepseek-chat / qwen-plus / moonshot-v1-8k / glm-4 / gpt-4o-mini
AI_MODEL=deepseek-chat

# 采样温度（0~1，越低越稳健），可选
AI_TEMPERATURE=0.4

# ===== 管理员令牌（可选）=====
# 设置后，"更新云端台账"需在请求头携带 X-Admin-Token（前端会提示输入并记住）。
# 留空表示任何人都可更新中心台账——内网封闭环境可留空，公网部署务必设置。
ADMIN_TOKEN=
